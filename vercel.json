{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    { "source": "/", "destination": "/ledger/", "permanent": false },
    { "source": "/app", "destination": "/quik1/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/ledger/:path*", "destination": "/api/ledger?path=:path*" },
    { "source": "/api/q1/:path*", "destination": "/api/q1?path=:path*" },
    { "source": "/api/quik1/:path*", "destination": "/api/quik1?path=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/ledger/([0-9a-f-]{36})\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/quik1/([0-9a-f-]{36})\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(ledger|quik1)/(react|react-dom)\\.production\\.min\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(ledger|quik1)/(.*)\\.(woff2|png|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
