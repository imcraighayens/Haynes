# Supabase project URL (Supabase dashboard -> Project Settings -> API). Server-only.
SUPABASE_URL=
# Supabase service role key (same page). Server-only: it bypasses RLS, so it never goes into either app.
SUPABASE_SERVICE_ROLE_KEY=
# Long random secret the LEDGER console sends as "Bearer" to /api/ledger and /api/q1. Generate: openssl rand -hex 32
LEDGER_KEY=
# Optional. Only when the apps are served from a different origin than /api (CORS); leave empty on Vercel.
# One origin, `*`, or a comma-separated list of exact origins. Quik1 and staff routes use this.
# The EcoLoans marketing ingest does not: /api/ecoloans has its own fixed allowlist.
ALLOWED_ORIGIN=
# Optional. Server-only staff unlock secret for POST /api/ledger/unlock. It mints a same-origin
# httpOnly staff cookie so /api/ledger/state works without pasting LEDGER_KEY into the browser.
# Never put this value in HTML, tests that print it, or client code. Leave empty to disable
# the unlock session (Bearer LEDGER_KEY still works for machines).
LEDGER_UNLOCK_PIN=
# Server-only manager secret for deleting a loan or replacing the book.
# Plain text, or sha256:<64 hex chars> of the secret. Never send it to the browser.
LEDGER_MANAGER_PIN=
# Explicit opt-in for the Settings "Reset demo data" control. Unset or anything other than
# true keeps it hidden. Also hidden when NODE_ENV=production or the host is quik1ledger.com
# or ecoloans-six.vercel.app.
LEDGER_ALLOW_DEMO_RESET=
# Server-only document reader. Set one or both. The browser never sees these.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional when both keys are set: anthropic or openai.
# LEDGER_AI_PROVIDER=
# Server-only Twilio. All three are required before a call or SMS is attempted.
# Leave them unset to show "Not configured". Do not put them in the staff UI.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Optional. Quik1 product credit limit used for available = credit_limit − outstanding principal.
# QUIK1_CREDIT_LIMIT=8000
# Optional. Public EcoLoans site ingest (POST /api/ecoloans/applications). Separate from the Quik1 caps.
# ECOLOANS_HOURLY_CAP=60
# ECOLOANS_PHONE_DAILY_CAP=3
# ECOLOANS_RATE_LIMIT=30
