# Supabase project URL (Supabase dashboard -> Project Settings -> API). Server-only.
SUPABASE_URL=
# Supabase service role key (same page). Server-only: it bypasses RLS, so it never goes into either app.
SUPABASE_SERVICE_ROLE_KEY=
# Long random secret the LEDGER console sends as "Bearer" to /api/ledger and /api/q1. Generate: openssl rand -hex 32
LEDGER_KEY=
# Optional. Only when the apps are served from a different origin than /api (CORS); leave empty on Vercel.
# One origin, `*`, or a comma-separated list of exact origins. Quik1 and staff routes use this.
# The EcoLoans marketing ingest does not: /api/ecoloans has its own fixed allowlist.
ALLOWED_ORIGIN=
# Staff Admin sign-in uses Supabase Auth on SUPABASE_URL (password grant). The allowlist is
# public.employees: an active row whose email matches, case-insensitive. That is the same
# rule as the auth.users sign-up trigger. The confirmed admin is craig@ecoloan.co.za.
# A second employee is added by inserting another active row. Do not put a password here.
# LEDGER_KEY stays the machine Connect secret. Staff do not paste it to sign in.
# There is no unlock PIN. Staff sign in with email and password.
# Server-only manager secret for deleting a loan or replacing the book.
# Plain text, or sha256:<64 hex chars> of the secret. Never send it to the browser.
LEDGER_MANAGER_PIN=
# Explicit opt-in for the Settings "Reset demo data" control. Unset or anything other than
# true keeps it hidden. Also hidden when NODE_ENV=production or the host is quik1ledger.com
# or ecoloans-six.vercel.app.
LEDGER_ALLOW_DEMO_RESET=
# Server-only document reader. Set one or both. The browser never sees these.
# Q1 chat answers from the book without these keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional when both keys are set: anthropic or openai.
# LEDGER_AI_PROVIDER=
# Server-only Twilio. All three are required before a call or SMS is attempted.
# Leave them unset to show "Not configured". Do not put them in the staff UI.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Optional. If set, each new Q1 chat message is POSTed as a JSON summary
# {source, at, page, message} so CEO Q1 can be notified. The message is scrubbed
# (no passwords, no 13-digit ID numbers, no book dump, no keys). Chat still
# answers when this is empty. No AI gateway key is required for replies.
# Q1_WEBHOOK_URL=
# Signs the Quik1 borrower session cookie. At least 32 characters.
# Generate with: openssl rand -hex 32
# Required with QUIK1_BORROWER_PIN=1 before a client can save a PIN or sign in.
# Server-only. Never put it in the app. Sign-in stays off when this is missing or shorter than 32 characters.
QUIK1_SESSION_SECRET=
# Single live switch for borrower PIN sign-in, including production. Must be exactly the
# string 1. true, yes, on, and any surrounding space stay off.
# Also requires QUIK1_SESSION_SECRET (32+ characters). On production (VERCEL_ENV=production,
# or quik1.app, www.quik1.app, quik1ledger.com, www.quik1ledger.com, ecoloans-six.vercel.app)
# QUIK1_ID_KEY and QUIK1_ID_HMAC_KEY must each be exactly 64 hex characters. A preview needs
# only this flag and the session secret. Leave unset and sign-in stays off.
# QUIK1_BORROWER_PIN=
# Staff preview: pick a Ledger client and load that client's book in Quik1.
# Must be exactly the string 1. true, yes, on, and any surrounding space stay off.
# Stays off on Vercel production and on quik1.app. Staff still need
# LEDGER_KEY or the staff cookie. The service role is never sent to the browser.
# QUIK1_PREVIEW_VIEW_AS_CLIENT=
# Optional. Hours before a staff invite link expires. Default 72.
# QUIK1_INVITE_TTL_HOURS=72
# Optional. Failed PIN attempts before the account locks. Default 5.
# QUIK1_PIN_MAX_ATTEMPTS=5
# Optional. Hours a borrower session stays valid. Default 12.
# QUIK1_SESSION_TTL_HOURS=12
# Optional. Minutes a PIN lock lasts before the counter resets. Default 15.
# A new staff invite still clears it immediately. Range 5 to 1440.
# QUIK1_LOCKOUT_MINUTES=15
# Optional. Minutes an email device link stays valid. Default 15.
# QUIK1_OTP_TTL_MINUTES=15
# Optional. Auth POSTs (login, redeem, email link, ID intake) allowed per IP per 15 minutes. Default 30.
# QUIK1_AUTH_RATE_LIMIT=30
# Borrower email for a new-device link. All three must be set, and production hosts stay off.
# Leave them unset. No provider is chosen here. Staff voice credentials are not used.
# QUIK1_EMAIL_FROM=
# QUIK1_EMAIL_API_URL=
# QUIK1_EMAIL_API_KEY=
# 32-byte key as 64 hex characters. Encrypts an SA ID for a signed-in borrower.
# Generate with: openssl rand -hex 32
# Server-only. Never log it and never put it in the app.
# Production PIN sign-in (QUIK1_BORROWER_PIN=1) stays off until this is exactly 64 hex characters.
# A preview can sign in without it. Storage returns 503 unless it is 64 hex characters.
# QUIK1_ID_KEY=
# Optional previous encryption key, same format, used only to read older ciphertext.
# QUIK1_ID_KEY_PREVIOUS=
# REQUIRED to store an SA ID. Separate 64-hex HMAC key. ID storage fails closed
# with 503 without it. Also used to match an ID plus cellphone. Production PIN
# sign-in stays off until this is exactly 64 hex characters. A preview can sign in without it.
# Leave unset until that intake is turned on.
# QUIK1_ID_HMAC_KEY=
# Optional. Seconds before another email or ID sign-in link. Default 60. Leave unset.
# QUIK1_SIGNIN_COOLDOWN_SECONDS=
# Optional. Email sign-in links per address per hour. Default 5. Leave unset.
# QUIK1_SIGNIN_HOURLY_CAP=
# Optional. ID and cellphone attempts per hour. Default 5. Leave unset.
# QUIK1_ID_PHONE_HOURLY_CAP=
# Optional. Minutes after sign-in during which Face ID can be saved. Default 15. Leave unset.
# QUIK1_PASSKEY_REGISTER_MINUTES=
# Optional. Max decoded size of one Quik1 document upload, in bytes. Default 1572864.
# Files go to the private q1-documents bucket with the service role. No public URL is returned.
# QUIK1_DOC_MAX_BYTES=1572864
# Optional. Public EcoLoans site ingest (POST /api/ecoloans/applications). Separate from the Quik1 caps.
# ECOLOANS_HOURLY_CAP=60
# ECOLOANS_PHONE_DAILY_CAP=3
# ECOLOANS_RATE_LIMIT=30
