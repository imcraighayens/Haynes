# Supabase project URL (Supabase dashboard -> Project Settings -> API). Server-only.
SUPABASE_URL=
# Supabase service role key (same page). Server-only: it bypasses RLS, so it never goes into either app.
SUPABASE_SERVICE_ROLE_KEY=
# Long random secret the LEDGER console sends as "Bearer" to /api/ledger and /api/q1. Generate: openssl rand -hex 32
LEDGER_KEY=
# Optional. Only when the apps are served from a different origin than /api (CORS); leave empty on Vercel.
# One origin, `*`, or a comma-separated list of exact origins. Quik1 and staff routes use this.
# The EcoLoans marketing ingest does not: /api/ecoloans has its own fixed allowlist.
ALLOWED_ORIGIN=
# Staff Admin sign-in uses Supabase Auth on SUPABASE_URL (password grant). The allowlist is
# public.employees: an active row whose email matches, case-insensitive. That is the same
# rule as the auth.users sign-up trigger. The confirmed admin is craig@ecoloan.co.za.
# A second employee is added by inserting another active row. Do not put a password here.
# LEDGER_KEY stays the machine Connect secret. Staff do not paste it to sign in.
# Optional. Server-only PIN for POST /api/ledger/unlock. It mints a same-origin httpOnly
# staff cookie. The Admin screen does not send it and never shows the value. Leave empty
# to disable that session (Bearer LEDGER_KEY still works for machines).
LEDGER_UNLOCK_PIN=
# Server-only manager secret for deleting a loan or replacing the book.
# Plain text, or sha256:<64 hex chars> of the secret. Never send it to the browser.
LEDGER_MANAGER_PIN=
# Explicit opt-in for the Settings "Reset demo data" control. Unset or anything other than
# true keeps it hidden. Also hidden when NODE_ENV=production or the host is quik1ledger.com
# or ecoloans-six.vercel.app.
LEDGER_ALLOW_DEMO_RESET=
# Server-only document reader. Set one or both. The browser never sees these.
# Q1 chat answers from the book without these keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional when both keys are set: anthropic or openai.
# LEDGER_AI_PROVIDER=
# Server-only Twilio. All three are required before a call or SMS is attempted.
# Leave them unset to show "Not configured". Do not put them in the staff UI.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Optional. If set, each new Q1 chat message is POSTed as a JSON summary
# {source, at, page, message} so CEO Q1 can be notified. The message is scrubbed
# (no passwords, no 13-digit ID numbers, no book dump, no keys). Chat still
# answers when this is empty. No AI gateway key is required for replies.
# Q1_WEBHOOK_URL=
# Optional. Signs the Quik1 borrower session cookie. At least 32 characters.
# Generate with: openssl rand -hex 32
# Required before a client can save a PIN or sign in, and only when QUIK1_BORROWER_PIN=1.
# Server-only. Never put it in the app. Leave the PIN flag unset in production.
QUIK1_SESSION_SECRET=
# Live borrower PIN. Must be exactly 1, and it still stays off when VERCEL_ENV=production
# or the host is quik1.app or quik1ledger.com (including www). Leave unset in production.
# QUIK1_BORROWER_PIN=
# Staff preview: pick a Ledger client and load that client's book in Quik1.
# Must be exactly 1. Stays off on Vercel production and on quik1.app. Staff still need
# LEDGER_KEY or the staff cookie. The service role is never sent to the browser.
# QUIK1_PREVIEW_VIEW_AS_CLIENT=
# Optional. Hours before a staff invite link expires. Default 72.
# QUIK1_INVITE_TTL_HOURS=72
# Optional. Failed PIN attempts before the account locks. Default 5.
# QUIK1_PIN_MAX_ATTEMPTS=5
# Optional. Hours a borrower session stays valid. Default 12.
# QUIK1_SESSION_TTL_HOURS=12
# Optional. Max decoded size of one Quik1 document upload, in bytes. Default 1572864.
# Files go to the private q1-documents bucket with the service role. No public URL is returned.
# QUIK1_DOC_MAX_BYTES=1572864
# Optional. Public EcoLoans site ingest (POST /api/ecoloans/applications). Separate from the Quik1 caps.
# ECOLOANS_HOURLY_CAP=60
# ECOLOANS_PHONE_DAILY_CAP=3
# ECOLOANS_RATE_LIMIT=30
