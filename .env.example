# Supabase project URL (Supabase dashboard -> Project Settings -> API). Server-only.
SUPABASE_URL=
# Supabase service role key (same page). Server-only: it bypasses RLS, so it never goes into either app.
SUPABASE_SERVICE_ROLE_KEY=
# Long random secret the LEDGER console sends as "Bearer" to /api/ledger and /api/q1. Generate: openssl rand -hex 32
LEDGER_KEY=
# Optional. Only when the apps are served from a different origin than /api (CORS); leave empty on Vercel.
ALLOWED_ORIGIN=
